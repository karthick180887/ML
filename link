import pandas as pd
import numpy as np
import matplotlib.pyplot as plt
import seaborn as sns
from sklearn.cluster import KMeans
from sklearn.preprocessing import StandardScaler
from sklearn.decomposition import PCA

# 1. Load
url = "https://archive.ics.uci.edu/ml/machine-learning-databases/00292/Wholesale%20customers%20data.csv"
df = pd.read_csv(url)

# 2. Drop categorical channel/region for purely behavioral clustering
features = ['Fresh', 'Milk', 'Grocery', 'Frozen', 'Detergents_Paper', 'Delicassen']
X = df[features]

# 3. Detect & cap outliers
# Many customers have order values 10x the median — distorts clustering
print("Skew before:", X.skew())

# Log-transform handles the skew nicely
X_log = np.log1p(X)
print("Skew after log:", X_log.skew())

# 4. Scale
scaler = StandardScaler()
X_scaled = scaler.fit_transform(X_log)

# 5. Find optimal K
inertias = []
for k in range(2, 11):
    km = KMeans(n_clusters=k, n_init=10, random_state=42).fit(X_scaled)
    inertias.append(km.inertia_)
plt.plot(range(2, 11), inertias, 'bo-'); plt.title('Elbow Method')
plt.xlabel('K'); plt.ylabel('Inertia'); plt.show()
# Typical K = 3

# 6. Cluster
kmeans = KMeans(n_clusters=3, n_init=10, random_state=42)
df['Segment'] = kmeans.fit_predict(X_scaled)

# 7. Profile in original (un-logged) scale
profile = df.groupby('Segment')[features].mean().round(0).astype(int)
print("\nAverage spending by segment (original units):")
print(profile)

# 8. Heatmap of segment profiles
plt.figure(figsize=(10, 5))
sns.heatmap(profile, annot=True, fmt='d', cmap='YlOrRd')
plt.title('Spending by Segment')
plt.show()

# 9. Cross-tab with channel — does ML recover hand-labeled types?
print("\nChannel distribution per cluster:")
print(pd.crosstab(df['Segment'], df['Channel']))
